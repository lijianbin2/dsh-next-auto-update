{
  "name": "dsh-next-auto-update",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Left-sidebar page that updates every registry-installed DSH plugin and DSH NEXT itself when the app opens.",
  "license": "MIT",
  "author": "lijianbin2",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auto-update",
    "plugin-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijianbin2/dsh-next-auto-update.git"
  },
  "homepage": "https://github.com/lijianbin2/dsh-next-auto-update#readme",
  "bugs": {
    "url": "https://github.com/lijianbin2/dsh-next-auto-update/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/desktop-install.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
